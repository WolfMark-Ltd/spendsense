# Spend Sense Model News feed — ACME BOOTSTRAP vhost. PREPARED, NOT INSTALLED.
#
# Install FIRST at activation (port 80 only), so certbot can validate before
# any TLS certificate exists. After issuance, replace with the full
# spendsense.wolfmark.co.uk.nginx. Run `nginx -t` before every reload.
#
# Privacy applies from this stage: access_log is OFF, so validation hits
# leave no request log. error_log stays at warn per house convention.

server {
    listen 80;
    listen [::]:80;
    server_name spendsense.wolfmark.co.uk;

    server_tokens off;

    access_log off;
    error_log /var/log/nginx/spendsense.wolfmark.co.uk.error.log warn;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://spendsense.wolfmark.co.uk$uri;
    }
}
