[Unit]
Description=Rebuild the Spend Sense Model News feed every six hours

# Monotonic schedule (elapsed time), deliberately not wall-clock: the host
# runs a non-UTC local timezone, and monotonic timers are
# timezone-independent, so the six-hour cadence is identical in UTC.

[Timer]
OnBootSec=10min
OnUnitInactiveSec=6h
AccuracySec=1min
Unit=wolfmark-spendsense-feed.service

[Install]
WantedBy=timers.target
