# Spend Sense Model News feed — prepared, NOT installed.
# At activation, place as <subdomain docroot>/feed/v1/.htaccess.
# Access logging cannot be disabled from .htaccess; see news-feed/README.md
# for the honest logging statement and the log-program steps.

<Files "news.json">
    ForceType application/json
    Header set Cache-Control "public, max-age=21600"
</Files>
Options -Indexes
